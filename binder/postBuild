# Binder image build: install the Groovy kernel on a JDK 25 runtime.
# The build itself runs on the apt-provided JDK; the kernel runs on Temurin 25.
set -euxo pipefail

# JDK 25 for the kernel runtime (arch-aware: x64 on mybinder, aarch64 elsewhere)
case "$(uname -m)" in
    aarch64|arm64) JDK_ARCH=aarch64 ;;
    *)             JDK_ARCH=x64 ;;
esac
mkdir -p "$HOME/jdk25"
curl -fsSL "https://api.adoptium.net/v3/binary/latest/25/ga/linux/${JDK_ARCH}/jdk/hotspot/normal/eclipse" \
    | tar xz -C "$HOME/jdk25" --strip-components=1
"$HOME/jdk25/bin/java" -version

# build the kernel and install the kernelspec (records the JDK 25 path)
./gradlew --no-daemon installKernelSpec -PjavaHome="$HOME/jdk25"
jupyter kernelspec list

# pre-warm the Grape cache for the headline notebooks so their first cell is fast
"$HOME/jdk25/bin/java" -cp "$HOME/.local/share/jupyter/kernels/groovy/lib/*" \
    groovy.ui.GroovyMain binder/prewarm.groovy

# trust the bundled notebooks so their saved rich outputs (SVG charts!) render
# immediately — untrusted notebooks have image/svg+xml sanitized away by Jupyter
jupyter trust notebooks/*.ipynb
